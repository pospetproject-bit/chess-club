# === Telegram ===
# Токен бота от @BotFather. Если пусто — приложение работает в ДЕМО-режиме
# (покупки симулируются, бот не запускается) — удобно для локальной разработки.
BOT_TOKEN=
# Username бота без @ (заполнится автоматически из getMe, можно задать явно)
BOT_USERNAME=
# Short name мини-аппа из BotFather /newapp (для deep-link t.me/bot/app?startapp=...)
APP_SHORT_NAME=play
# Прямой HTTPS-адрес задеплоенного мини-аппа (приоритетнее t.me-ссылки)
WEBAPP_URL=

# === Реклама (Adsgram — официальный партнёр Telegram Mini Apps) ===
# ID блоков из кабинета adsgram.ai. Пусто = реклама не показывается.
ADSGRAM_INTERSTITIAL_ID=
ADSGRAM_REWARDED_ID=

# === Прочее ===
PORT=3000
# Username поддержки для /paysupport (требование Telegram для цифровых товаров)
SUPPORT_USERNAME=your_support
# Ссылка на условия использования (требование для Stars-платежей)
TERMS_URL=
# Принудительно демо-режим (1) даже с токеном; по умолчанию = !BOT_TOKEN
DEMO_MODE=
